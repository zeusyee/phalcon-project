                            <th>Email</th>
                            <th>Phone</th>
                            <th>City</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($customers as $customer): ?>
                        <tr>
                            <td><?php echo htmlspecialchars($customer['id']); ?></td>
                            <td>
                                <?php echo htmlspecialchars($customer['name']); ?>
                                <?php if (isset($customer['ref']) && strpos($customer['ref'], 'WIFI-') === 0): ?>
                                    <span class="badge">WiFi User</span>
                                <?php endif; ?>
                            </td>
                            <td><?php echo htmlspecialchars($customer['ref'] ?? '-'); ?></td>
                            <td><?php echo htmlspecialchars($customer['email'] ?? '-'); ?></td>
                            <td><?php echo htmlspecialchars($customer['phone'] ?? $customer['mobile'] ?? '-'); ?></td>
                            <td><?php echo htmlspecialchars($customer['city'] ?? '-'); ?></td>
                        </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            <?php else: ?>
                <div class="alert-error">
                    Tidak ada data customer. Silakan buat customer baru di Odoo atau gunakan menu Create Customer.
                </div>
            <?php endif; ?>
            
