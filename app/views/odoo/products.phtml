<body>
    <div class="container">
        <div class="header">
            <div style="display: flex; align-items: center; gap: 18px;">
                <a href="/odoo" class="btn-back">
                    <span class="icon">&#8592;</span> Kembali
                </a>
                <h1>📦 Products dari Odoo</h1>
            </div>
            <button class="btn btn-primary" onclick="showCreateModal()">+ Tambah Product</button>
        </div>
        
        <div id="alertSuccess" class="alert-success" style="display:none;"></div>
        
        <?php if (isset($error)): ?>
            <div class="alert-error">
                <strong>Error:</strong> <?php echo htmlspecialchars($error); ?>
            </div>
        <?php endif; ?>
        
        <?php if (isset($products) && count($products) > 0): ?>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nama Product</th>
                        <th>Kode</th>
                        <th>Tipe</th>
                        <th>Harga Jual</th>
                        <th>Harga Cost</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($products as $product): ?>
                    <tr>
                        <td><?php echo htmlspecialchars($product['id']); ?></td>
                        <td><?php echo htmlspecialchars($product['name']); ?></td>
                        <td><?php echo htmlspecialchars($product['default_code'] ?? '-'); ?></td>
                        <td>
                            <?php 
                            $type = $product['type'] ?? 'consu';
                            $badgeClass = $type === 'service' ? 'badge-service' : 'badge-consumable';
                            ?>
                            <span class="badge <?php echo $badgeClass; ?>">
                                <?php echo strtoupper($type); ?>
                            </span>
                        </td>
                        <td>Rp <?php echo number_format($product['list_price'] ?? 0, 0, ',', '.'); ?></td>
                        <td>Rp <?php echo number_format($product['standard_price'] ?? 0, 0, ',', '.'); ?></td>
                        <td class="actions">
                            <button class="btn btn-warning btn-sm" onclick='editProduct(<?php echo json_encode($product); ?>)'>Edit</button>
                            <button class="btn btn-danger btn-sm" onclick="deleteProduct(<?php echo $product['id']; ?>)">Delete</button>
                        </td>
                    </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        <?php else: ?>
            <div class="alert-error">
                Tidak ada data product.
            </div>
        <?php endif; ?>
    </div>

    <!-- Modal Create/Edit Product -->
    <div id="productModal" class="modal">
        <div class="modal-content">
            <h2 id="modalTitle">Tambah Product</h2>
            <form id="productForm">
                <input type="hidden" id="productId">
                
                <div class="form-group">
                    <label for="name">Nama Product *</label>
                    <input type="text" id="name" name="name" required placeholder="Masukkan nama product">
                </div>
                
                <div class="form-group">
                    <label for="default_code">Kode/SKU</label>
                    <input type="text" id="default_code" name="default_code" placeholder="Opsional">
                </div>
                
                <div class="form-group">
                    <label for="type">Tipe Product *</label>
                    <select id="type" name="type" required>
                        <option value="consu">Consumable</option>
                        <option value="service">Service</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="list_price">Harga Jual *</label>
                    <input type="number" id="list_price" name="list_price" step="0.01" required placeholder="0">
                </div>
                
                <div class="form-group">
                    <label for="standard_price">Harga Cost</label>
                    <input type="number" id="standard_price" name="standard_price" step="0.01" placeholder="0">
                </div>
                
                <div class="form-buttons">
                    <button type="submit" class="btn btn-success">Simpan</button>
                    <button type="button" class="btn btn-danger" onclick="closeModal()">Batal</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let isEditMode = false;

        function showCreateModal() {
            document.getElementById('modalTitle').textContent = 'Tambah Product';
            document.getElementById('productForm').reset();
            document.getElementById('productId').value = '';
            document.getElementById('type').disabled = false;
            isEditMode = false;
            document.getElementById('productModal').style.display = 'block';
        }

        function editProduct(product) {
            document.getElementById('modalTitle').textContent = 'Edit Product';
            document.getElementById('productId').value = product.id;
            document.getElementById('name').value = product.name;
            document.getElementById('default_code').value = product.default_code || '';
            document.getElementById('type').value = product.type || 'consu';
            document.getElementById('list_price').value = product.list_price || 0;
            document.getElementById('standard_price').value = product.standard_price || 0;
            document.getElementById('type').disabled = true;
            isEditMode = true;
            document.getElementById('productModal').style.display = 'block';
        }

        function closeModal() {
            document.getElementById('productModal').style.display = 'none';
        }

        function showAlert(message, type) {
            const alertDiv = document.getElementById('alertSuccess');
            alertDiv.textContent = message;
            alertDiv.className = type === 'success' ? 'alert-success' : 'alert-error';
            alertDiv.style.display = 'block';
            setTimeout(() => { alertDiv.style.display = 'none'; }, 5000);
        }

        document.getElementById('productForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const productId = document.getElementById('productId').value;
            const url = isEditMode ? `/odoo/update-product/${productId}` : '/odoo/create-product';
            
            try {
                const response = await fetch(url, {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showAlert(result.message, 'success');
                    closeModal();
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showAlert(result.message, 'error');
                }
            } catch (error) {
                showAlert('Error: ' + error.message, 'error');
            }
        });

        async function deleteProduct(id) {
            if (!confirm('Yakin ingin menghapus product ini?')) return;
            
            try {
                const response = await fetch(`/odoo/delete-product/${id}`, {
                    method: 'POST'
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showAlert(result.message, 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showAlert(result.message, 'error');
                }
            } catch (error) {
                showAlert('Error: ' + error.message, 'error');
            }
        }
        
        // Close modal when clicking outside
        document.getElementById('productModal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });
    </script>
</body>
</html>
