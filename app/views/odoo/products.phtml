<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Odoo - Products</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .container {
            max-width: 1200px;
            margin: 50px auto;
            padding: 20px;
        }
        
        .header {
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            margin-bottom: 30px;
        }
        
        table {
            width: 100%;
            background: white;
            border-collapse: collapse;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            border-radius: 10px;
            overflow: hidden;
        }
        
        th, td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }
        
        th {
            background: #667eea;
            color: white;
        }
        
        .alert-error {
            background: #f8d7da;
            color: #721c24;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        
        .badge {
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 12px;
            font-weight: bold;
        }
        
        .badge-stockable {
            background: #d4edda;
            color: #155724;
        }
        
        .badge-service {
            background: #cce5ff;
            color: #004085;
        }
        
        .badge-consumable {
            background: #fff3cd;
            color: #856404;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <a href="/odoo">← Kembali</a>
            <h1>📦 Daftar Products dari Odoo</h1>
        </div>
        
        <?php if (isset($error)): ?>
            <div class="alert-error">
                <strong>Error:</strong> <?php echo htmlspecialchars($error); ?>
            </div>
        <?php endif; ?>
        
        <?php if (isset($products) && count($products) > 0): ?>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Code</th>
                        <th>Type</th>
                        <th>Sales Price</th>
                        <th>Cost</th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($products as $product): ?>
                    <tr>
                        <td><?php echo htmlspecialchars($product['id']); ?></td>
                        <td><?php echo htmlspecialchars($product['name']); ?></td>
                        <td><?php echo htmlspecialchars($product['default_code'] ?? '-'); ?></td>
                        <td>
                            <?php 
                            $type = $product['type'] ?? 'consu';
                            $badgeClass = 'badge-consumable';
                            if ($type === 'product') $badgeClass = 'badge-stockable';
                            if ($type === 'service') $badgeClass = 'badge-service';
                            ?>
                            <span class="badge <?php echo $badgeClass; ?>">
                                <?php echo strtoupper($type); ?>
                            </span>
                        </td>
                        <td>Rp <?php echo number_format($product['list_price'] ?? 0, 0, ',', '.'); ?></td>
                        <td>Rp <?php echo number_format($product['standard_price'] ?? 0, 0, ',', '.'); ?></td>
                    </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        <?php else: ?>
            <div class="alert-error">
                Tidak ada data product.
            </div>
        <?php endif; ?>
    </div>
</body>
</html>
