    <script>
        // Show payment modal
        function showPaymentModal(invoiceId, invoiceName, totalAmount) {
            document.getElementById('payment_invoice_id').value = invoiceId;
            document.getElementById('payment_invoice_name').value = invoiceName;
            document.getElementById('payment_total').value = 'Rp ' + new Intl.NumberFormat('id-ID').format(totalAmount);
            document.getElementById('payment_amount').value = totalAmount;
            document.getElementById('paymentModal').style.display = 'block';
        }

        // Close payment modal
        function closePaymentModal() {
            document.getElementById('paymentModal').style.display = 'none';
            document.getElementById('paymentForm').reset();
        }

        // Payment form submission
        document.getElementById('paymentForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            
            fetch('/odoo/process-payment', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showAlert('Pembayaran berhasil diproses!', 'success');
                    closePaymentModal();
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showAlert('Error: ' + data.message, 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showAlert('Terjadi kesalahan saat memproses pembayaran', 'error');
            });
        });

        // Close payment modal when clicking outside
        document.getElementById('paymentModal').addEventListener('click', function(e) {
            if (e.target === this) closePaymentModal();
        });

        // Existing functions
        function showCreateModal() {
            document.getElementById('invoiceForm').reset();
            document.getElementById('invoiceModal').style.display = 'block';
        }

        function closeModal() {
            document.getElementById('invoiceModal').style.display = 'none';
        }

        function showAlert(message, type) {
            const alertDiv = document.getElementById('alertSuccess');
            alertDiv.textContent = message;
            alertDiv.className = type === 'success' ? 'alert-success' : 'alert-error';
            alertDiv.style.display = 'block';
            setTimeout(() => { alertDiv.style.display = 'none'; }, 5000);
        }

        document.getElementById('invoiceForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            
            try {
                const response = await fetch('/odoo/create-invoice', {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showAlert(result.message, 'success');
                    closeModal();
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showAlert(result.message, 'error');
                }
            } catch (error) {
                showAlert('Error: ' + error.message, 'error');
            }
        });

        async function deleteInvoice(id) {
            if (!confirm('Yakin ingin menghapus Invoice ini?')) return;
            
            try {
                const response = await fetch(`/odoo/delete-invoice/${id}`, {
                    method: 'POST'
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showAlert(result.message, 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showAlert(result.message, 'error');
                }
            } catch (error) {
                showAlert('Error: ' + error.message, 'error');
            }
        }

        // Close modal when clicking outside
        document.getElementById('invoiceModal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });

        // Add new invoice line
        function addInvoiceLine() {
            const container = document.getElementById('invoiceLinesContainer');
            const firstLine = container.querySelector('.invoice-line-item');
            const newLine = document.createElement('div');
            newLine.className = 'invoice-line-item';
            newLine.innerHTML = `
                <select name="product_ids[]" required>
                    ${firstLine.querySelector('select').innerHTML}
                </select>
                <input type="number" name="quantities[]" value="1" min="1" placeholder="Qty" required>
                <button type="button" class="btn-remove" onclick="removeInvoiceLine(this)">✕</button>
            `;
            container.appendChild(newLine);
        }

        // Remove invoice line
        function removeInvoiceLine(btn) {
            btn.parentElement.remove();
        }
    </script>
</body>
</html>
