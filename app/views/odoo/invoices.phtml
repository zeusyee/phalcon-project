        .badge-paid {
            background: #17a2b8;
            color: white;
        }
        
        .badge-partial {
            background: #fd7e14;
            color: white;
        }
        
        .badge-cancel {
            background: #dc3545;
            color: white;
        }
        
        .btn {
            display: inline-block;
            padding: 10px 20px;
