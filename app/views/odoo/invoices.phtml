        .header a {
            color: #667eea;
            text-decoration: none;
            font-weight: 600;
        }
        
        .header h1 {
            color: #333;
            margin: 10px 0;
        }
        
        .content {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }
        
        .alert-error {
            background: #f8d7da;
