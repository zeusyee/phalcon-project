</head>
<body>
    <div class="container">
        <div class="header">
            <a href="/odoo">← Kembali</a>
            <h1>🧾 Invoices dari Odoo</h1>
        </div>
        
        <div class="content">
            <?php if (isset($error)): ?>
                <div class="alert-error">
                    <strong>Error:</strong> <?php echo htmlspecialchars($error); ?>
                </div>
            <?php endif; ?>
            
            <?php if (isset($invoices) && count($invoices) > 0): ?>
                <h2>Daftar Invoices (Top 20)</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Invoice #</th>
                            <th>Customer</th>
                            <th>Invoice Date</th>
                            <th>Amount</th>
                            <th>Payment Status</th>
                            <th>State</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($invoices as $invoice): ?>
                        <tr>
                            <td><?php echo htmlspecialchars($invoice['name'] ?? '-'); ?></td>
                            <td>
                                <?php 
                                if (isset($invoice['partner_id']) && is_array($invoice['partner_id'])) {
                                    echo htmlspecialchars($invoice['partner_id'][1]);
                                } else {
                                    echo '-';
                                }
                                ?>
                            </td>
                            <td><?php echo htmlspecialchars($invoice['invoice_date'] ?? '-'); ?></td>
                            <td>Rp <?php echo number_format($invoice['amount_total'] ?? 0, 0, ',', '.'); ?></td>
                            <td>
                                <?php 
                                $payment = $invoice['payment_state'] ?? 'not_paid';
                                $badgeClass = 'badge-draft';
                                $label = $payment;
                                
                                if ($payment === 'paid') {
                                    $badgeClass = 'badge-paid';
                                    $label = 'PAID';
                                } elseif ($payment === 'partial') {
                                    $badgeClass = 'badge-partial';
                                    $label = 'PARTIAL';
                                } elseif ($payment === 'not_paid') {
                                    $badgeClass = 'badge-draft';
                                    $label = 'NOT PAID';
                                }
                                ?>
                                <span class="badge <?php echo $badgeClass; ?>"><?php echo $label; ?></span>
                            </td>
                            <td>
                                <?php 
                                $state = $invoice['state'] ?? 'draft';
                                $stateBadge = 'badge-draft';
                                $stateLabel = $state;
                                
                                if ($state === 'posted') {
                                    $stateBadge = 'badge-posted';
                                    $stateLabel = 'POSTED';
                                } elseif ($state === 'draft') {
                                    $stateBadge = 'badge-draft';
                                    $stateLabel = 'DRAFT';
                                } elseif ($state === 'cancel') {
                                    $stateBadge = 'badge-cancel';
                                    $stateLabel = 'CANCELLED';
                                }
                                ?>
                                <span class="badge <?php echo $stateBadge; ?>"><?php echo $stateLabel; ?></span>
                            </td>
                        </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            <?php else: ?>
                <div class="alert-error">
                    Tidak ada data invoice. Silakan buat invoice di Odoo terlebih dahulu.
                </div>
            <?php endif; ?>
            
            <a href="/odoo" class="btn">← Kembali ke Dashboard</a>
            <a href="http://localhost:8069" target="_blank" class="btn">Buka Odoo Web →</a>
        </div>
    </div>
</body>
</html>
