<body>
    <div class="container">
        <div class="header">
            <a href="/odoo">← Kembali</a>
            <h1>🛍️ Purchase Orders dari Odoo</h1>
        </div>
        
        <div class="content">
            <?php if (isset($error) && $error): ?>
                <div class="alert-error">
                    <strong>Error:</strong> <?php echo htmlspecialchars($error); ?>
                </div>
            <?php endif; ?>
            
            <?php if (isset($orders) && count($orders) > 0): ?>
                <h2>Daftar Purchase Orders (Top 20)</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Vendor</th>
                            <th>Order Date</th>
                            <th>Total Amount</th>
                            <th>Invoice Status</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($orders as $order): ?>
                        <tr>
                            <td><?php echo htmlspecialchars($order['name'] ?? '-'); ?></td>
                            <td>
                                <?php 
                                if (isset($order['partner_id']) && is_array($order['partner_id'])) {
                                    echo htmlspecialchars($order['partner_id'][1]);
                                } else {
                                    echo '-';
                                }
                                ?>
                            </td>
                            <td><?php echo htmlspecialchars($order['date_order'] ?? '-'); ?></td>
                            <td>Rp <?php echo number_format($order['amount_total'] ?? 0, 0, ',', '.'); ?></td>
                            <td>
                                <?php 
                                $invoiceStatus = $order['invoice_status'] ?? 'no';
                                $badgeClass = 'badge-draft';
                                $label = $invoiceStatus;
                                
                                if ($invoiceStatus === 'invoiced') {
                                    $badgeClass = 'badge-done';
                                    $label = 'INVOICED';
                                } elseif ($invoiceStatus === 'to invoice') {
                                    $badgeClass = 'badge-waiting';
                                    $label = 'TO INVOICE';
                                } elseif ($invoiceStatus === 'no') {
                                    $badgeClass = 'badge-draft';
                                    $label = 'NO INVOICE';
                                }
                                ?>
                                <span class="badge <?php echo $badgeClass; ?>"><?php echo $label; ?></span>
                            </td>
                            <td>
                                <?php 
                                $state = $order['state'] ?? 'draft';
                                $stateBadge = 'badge-draft';
                                $stateLabel = $state;
                                
                                if ($state === 'purchase') {
                                    $stateBadge = 'badge-purchase';
                                    $stateLabel = 'CONFIRMED';
                                } elseif ($state === 'done') {
                                    $stateBadge = 'badge-done';
                                    $stateLabel = 'DONE';
                                } elseif ($state === 'draft') {
                                    $stateBadge = 'badge-draft';
                                    $stateLabel = 'RFQ';
                                } elseif ($state === 'cancel') {
                                    $stateBadge = 'badge-cancel';
                                    $stateLabel = 'CANCELLED';
                                }
                                ?>
                                <span class="badge <?php echo $stateBadge; ?>"><?php echo $stateLabel; ?></span>
                            </td>
                        </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            <?php else: ?>
                <div class="alert-error">
                    Tidak ada data purchase order. Silakan buat purchase order di Odoo terlebih dahulu.
                </div>
            <?php endif; ?>
            
            <a href="/odoo" class="btn">← Kembali ke Dashboard</a>
            <a href="http://localhost:8069" target="_blank" class="btn">Buka Odoo Web →</a>
        </div>
    </div>
</body>
</html>
