    <script>
        function showCreateModal() {
            document.getElementById('salesOrderForm').reset();
            document.getElementById('salesOrderModal').style.display = 'block';
        }

        function closeModal() {
            document.getElementById('salesOrderModal').style.display = 'none';
        }

        function showAlert(message, type) {
            const alertDiv = document.getElementById('alertSuccess');
            alertDiv.textContent = message;
            alertDiv.className = type === 'success' ? 'alert-success' : 'alert-error';
            alertDiv.style.display = 'block';
            setTimeout(() => { alertDiv.style.display = 'none'; }, 5000);
        }

        document.getElementById('salesOrderForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            
            try {
                const response = await fetch('/odoo/create-sales-order', {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showAlert(result.message, 'success');
                    closeModal();
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showAlert(result.message, 'error');
                }
            } catch (error) {
                showAlert('Error: ' + error.message, 'error');
            }
        });

        async function deleteSalesOrder(id) {
            if (!confirm('Yakin ingin menghapus Sales Order ini?')) return;
            
            try {
                const response = await fetch(`/odoo/delete-sales-order/${id}`, {
                    method: 'POST'
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showAlert(result.message, 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showAlert(result.message, 'error');
                }
            } catch (error) {
                showAlert('Error: ' + error.message, 'error');
            }
        }

        // Close modal when clicking outside
        document.getElementById('salesOrderModal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });

        // Add new order line
        function addOrderLine() {
            const container = document.getElementById('orderLinesContainer');
            const firstLine = container.querySelector('.order-line-item');
            const newLine = document.createElement('div');
            newLine.className = 'order-line-item';
            newLine.innerHTML = `
                <select name="product_ids[]" required>
                    ${firstLine.querySelector('select').innerHTML}
                </select>
                <input type="number" name="quantities[]" value="1" min="1" placeholder="Qty" required>
                <button type="button" class="btn-remove" onclick="removeOrderLine(this)">✕</button>
            `;
            container.appendChild(newLine);
        }

        // Remove order line
        function removeOrderLine(btn) {
            btn.parentElement.remove();
        }
    </script>
</body>
